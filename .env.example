# ---------- Database (PostgreSQL) ----------
# ใช้ connection string จริงจากผู้ให้บริการ เช่น Vercel Postgres, Neon, Supabase
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------- Admin session ----------
# ใช้เซ็น/ตรวจสอบ JWT สำหรับ session ของแอดมิน สุ่มด้วยคำสั่ง เช่น:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-64-char-hex-string"

# ---------- LINE LIFF ----------
# สมัคร LIFF app ได้ที่ LINE Developers Console (ดูขั้นตอนใน README.md หัวข้อ "ตั้งค่า LINE LIFF")
# หากยังไม่มี ปล่อยว่างไว้ได้ — เว็บจะ fallback ทำงานปกตินอก LINE
NEXT_PUBLIC_LIFF_ID=""

# URL เต็มของเว็บไซต์ (ใช้ทำ Open Graph tags และ LIFF redirect) เช่น https://your-shop.vercel.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---------- Web Push (VAPID) ----------
# สร้างด้วยคำสั่ง: npx web-push generate-vapid-keys
# ดูขั้นตอนเต็มใน README.md หัวข้อ "ตั้งค่า Web Push (VAPID)"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ---------- Image storage ----------
# "local" = เก็บไฟล์ใน public/uploads (ใช้ตอนพัฒนาบนเครื่อง local เท่านั้น)
# "vercel-blob" = ใช้ Vercel Blob storage (จำเป็นสำหรับ production บน Vercel เพราะ filesystem เป็น read-only)
# หมายเหตุ: ถ้าปล่อยว่างไว้ ระบบจะเลือก "vercel-blob" ให้อัตโนมัติเมื่อ deploy อยู่บน Vercel
STORAGE_PROVIDER="local"
# จำเป็นเมื่อ STORAGE_PROVIDER="vercel-blob" — สร้างได้จาก Vercel dashboard > Storage > Create Database > Blob
BLOB_READ_WRITE_TOKEN=""
